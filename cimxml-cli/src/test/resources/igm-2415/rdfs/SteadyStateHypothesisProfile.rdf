<rdf:RDF
    xmlns:cims="http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:cim="http://iec.ch/TC57/2013/CIM-schema-cim16#"
    xmlns:entsoe="http://entsoe.eu/CIM/SchemaExtension/3/1#"
    xml:base="http://iec.ch/TC57/2013/CIM-schema-cim16">
  <rdf:Description rdf:about="http://entsoe.eu/CIM/SchemaExtension/3/1#SteadyStateHypothesisVersion">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="en">SteadyStateHypothesisVersion</rdfs:label>
    <cims:stereotype>Entsoe</cims:stereotype>
  </rdf:Description>
  <rdf:Description rdf:about="http://entsoe.eu/CIM/SchemaExtension/3/1#SteadyStateHypothesisVersion.shortName">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdfs:label xml:lang="en">shortName</rdfs:label>
    <rdfs:domain rdf:resource="http://entsoe.eu/CIM/SchemaExtension/3/1#SteadyStateHypothesisVersion"/>
    <cims:dataType rdf:resource="#String"/>
    <cims:isFixed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SSH</cims:isFixed>
  </rdf:Description>
  <rdf:Description rdf:about="http://entsoe.eu/CIM/SchemaExtension/3/1#SteadyStateHypothesisVersion.entsoeURI">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdfs:label xml:lang="en">entsoeURI</rdfs:label>
    <rdfs:domain rdf:resource="http://entsoe.eu/CIM/SchemaExtension/3/1#SteadyStateHypothesisVersion"/>
    <cims:dataType rdf:resource="#String"/>
    <cims:isFixed rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://entsoe.eu/CIM/SteadyStateHypothesis/1/1</cims:isFixed>
  </rdf:Description>
  <rdf:Description rdf:about="#EnergyConsumer">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="en">EnergyConsumer</rdfs:label>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#concrete"/>
  </rdf:Description>
  <rdf:Description rdf:about="#EnergyConsumer.p">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <cims:stereotype rdf:resource="http://iec.ch/TC57/NonStandard/UML#attribute"/>
    <rdfs:label xml:lang="en">p</rdfs:label>
    <rdfs:domain rdf:resource="#EnergyConsumer"/>
    <cims:dataType rdf:resource="#Float"/>
  </rdf:Description>
  <rdf:Description rdf:about="#String">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="en">String</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
  </rdf:Description>
  <rdf:Description rdf:about="#Float">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="en">Float</rdfs:label>
    <cims:stereotype>Primitive</cims:stereotype>
  </rdf:Description>
</rdf:RDF>
