{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2021",
        "outDir": "out",
        "lib": ["ES2021", "ES2022.Error"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "vscode"]
    },
    "exclude": ["node_modules", ".vscode-test"]
}
