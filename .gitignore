# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

/cimxml/target/
target/

# IntelliJ IDEA: ignore per-user project files, but commit the shared Google-style
# code-style scheme under .idea/codeStyles/ so every contributor formats identically,
# and the shared Apache-2.0 copyright profile under .idea/copyright/ so IntelliJ
# inserts the same SOPTIM license header the CI header checks enforce.
.idea/*
!.idea/codeStyles/
!.idea/copyright/
