# Keep the Docker build context small and the build reproducible. The CLI images
# (cimvocabcheck/Dockerfile, cimxml-cli/Dockerfile) build from source and only need cimxml/ plus
# their own module.

.git
.github
.idea
**/target
**/node_modules

# Other components / unrelated top-level dirs not needed to build the CLI.
docs
cimnotebook
gitlab-cimvocabcheck
QueryAndValidationUI
org
scripts

# The large ENTSO-E application-profiles submodule is test data, not needed to build the CLI.
cimvocabcheck/core/testing
cimvocabcheck/sbom
cimxml-cli/testing

# Local build / report scratch.
*.log
gl-code-quality-report.json
