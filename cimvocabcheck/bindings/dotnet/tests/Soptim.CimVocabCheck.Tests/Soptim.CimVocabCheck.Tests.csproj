<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
        Every framework the package targets: each build compiles against its own framework's
        libraries (System.Text.Json among them), so passing on one says nothing about the other.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Test fixtures name themselves; the documentation gate is for the shipped package. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <!-- v3 for Assert.Skip: an engine-backed test must be able to skip itself at run time. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Soptim.CimVocabCheck/Soptim.CimVocabCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
